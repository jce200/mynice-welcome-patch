<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and up show a splash screen of their own before the app: the same field, with the icon (the foreground of the adaptive icon) -->
    <style name="NxTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/nx_splash_field</item>
        <item name="android:windowSplashScreenBackground">@color/nx_splash_field</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
