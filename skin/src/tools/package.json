{
  "name": "skin-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Generates skin/src/tokens.css (Material 3 color roles and spring curves) from one seed color.",
  "scripts": {
    "build:tokens": "esbuild build-tokens.mjs --bundle --platform=node --format=esm --outfile=.build/build-tokens.mjs --log-level=error && node .build/build-tokens.mjs > ../tokens.css"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "esbuild": "^0.28.2"
  }
}
